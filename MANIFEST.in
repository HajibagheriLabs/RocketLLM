# The sdist is what redistributors and anyone building from source actually get, so it carries the
# prose that explains the project as well as the code: setuptools ships README/LICENSE/NOTICE and
# the package on its own, but not these.
include CONTRIBUTING.md
recursive-include docs *.md
recursive-include examples *.py *.ipynb

# Machine-specific benchmark records and local working notes are meaningless outside the repo.
exclude PLAYBOOK.md
prune bench_results
