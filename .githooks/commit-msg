#!/bin/sh
#
# Strip tool-generated trailers from commit messages.
#
# Everything in this repository is published under the maintainer's name, so a commit message must
# never carry a tool footer or a co-author trailer of any kind. Editors and CLIs add
# those automatically, so rather than relying on remembering to delete them, this hook removes them
# on the way in.
#
# Removed:
#   * any Co-authored-by: trailer added by an editor or tool
#   * "Generated with ..." footers
#   * any line that is only a tool URL
#   * any line containing the robot emoji (it only ever shows up in those footers)
# Trailing blank lines left behind by the above are collapsed.
#
# The hook never rejects a commit; it only edits the message. It is wired up with:
#   git config core.hooksPath .githooks

set -e

msg_file="$1"
[ -n "$msg_file" ] || exit 0
[ -f "$msg_file" ] || exit 0

tmp_file="${msg_file}.attribution.tmp"

awk '
{
    low = tolower($0)

    if (low ~ /^[ \t]*co-authored-by:/) next
    if (low ~ /generated with/) next
    if (low ~ /^[ \t]*https?:\/\/[^ \t]*$/) next
    if (low ~ /generated by /) next

    # Hold blank lines back so any that end up trailing the message are dropped, while blank
    # lines between real paragraphs survive. Removing a footer leaves a blank line on either
    # side of the gap, so a run collapses to one — which is what git would do anyway.
    if ($0 ~ /^[ \t]*$/) { pending = 1; next }
    if (pending) { print ""; pending = 0 }
    print
}
' "$msg_file" > "$tmp_file"

mv "$tmp_file" "$msg_file"

exit 0
