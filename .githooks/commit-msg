#!/bin/sh
#
# Strip tool-generated trailers and footers from commit messages.
#
# Everything in this repository is published under the maintainer's name, and a commit message here
# ends with its body and nothing else. Editors, IDEs and command-line tools routinely append
# trailers and footers of their own, so rather than relying on remembering to delete them, this hook
# removes them on the way in.
#
# Removed:
#   * any Co-authored-by: trailer (this project is single-maintainer; a real co-author would be
#     recorded as the commit author, not as a trailer)
#   * "Generated with ..." and "Generated by ..." footers, wherever they sit on the line
#   * footer lines that are just a tool's URL
# Trailing blank lines left behind by the above are collapsed.
#
# The hook never rejects a commit; it only edits the message. It is wired up with:
#   git config core.hooksPath .githooks

set -e

msg_file="$1"
[ -n "$msg_file" ] || exit 0
[ -f "$msg_file" ] || exit 0

tmp_file="${msg_file}.trailers.tmp"

awk '
{
    low = tolower($0)

    if (low ~ /^[ \t]*co-authored-by:/) next
    # Unanchored: these footers are commonly prefixed with a glyph or a marker, and matching the
    # phrase itself catches every such variant without this file having to enumerate them.
    if (low ~ /generated with/) next
    if (low ~ /generated by /) next
    if (low ~ /^[ \t]*https?:\/\/[^ \t]*$/) next

    # Hold blank lines back so any that end up trailing the message are dropped, while blank
    # lines between real paragraphs survive. Removing a footer leaves a blank line on either
    # side of the gap, so a run collapses to one — which is what git would do anyway.
    if ($0 ~ /^[ \t]*$/) { pending = 1; next }
    if (pending) { print ""; pending = 0 }
    print
}
' "$msg_file" > "$tmp_file"

mv "$tmp_file" "$msg_file"

exit 0
